<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".playlists.ui.PlaylistsFragment"
    android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/NewPlaylistButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:backgroundTint="?attr/colorOnPrimaryFixedVariant"
            android:fontFamily="@font/ys_display_medium"
            android:letterSpacing="0"
            android:text="@string/new_playlist"
            android:textAllCaps="false"
            android:textColor="?attr/colorPrimary"
            android:textFontWeight="500"
            android:textSize="14sp"
            app:cornerRadius="54dp" />

        <ImageView
            android:id="@+id/errorImage"
            android:layout_width="match_parent"
            android:layout_marginTop="46dp"
            android:layout_height="120dp"
            app:srcCompat="@drawable/empty_response" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:fontFamily="@font/ys_display_medium"
            android:text="@string/no_playlist"
            android:textColor="?attr/colorOnPrimaryFixedVariant"
            android:textFontWeight="400"
            android:textSize="19sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/playlistsView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="12dp"
        android:clipToPadding="false"/>



</LinearLayout>
